{
  "manifest_version": 3,
  "name": "ClaudeStyle",
  "version": "1.0.0",
  "description": "Your own background, fonts and Quick CSS for Claude. Open with the palette button or Ctrl+Shift+Y.",
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "mod.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "128": "icon128.png"
  }
}